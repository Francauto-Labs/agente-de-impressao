# Porta do agent
PORT=4005

# Modo de saída para a impressora:
#   pcl       -> converte para PCL6 (recomendado, resolve o erro de PDF Direct Print)
#   ps        -> converte para PostScript (se a impressora tiver kit PS)
#   normalize -> baixa o PDF para 1.4 + flatten e envia como PDF (usa o PDF Direct Print)
#   raw       -> envia o PDF cru (comportamento antigo)
PRINT_MODE=pcl

# true se a impressora for colorida (afeta pcl/ps)
PRINT_COLOR=false

# Binário do Ghostscript (na imagem alpine é "gs")
GHOSTSCRIPT_BIN=gs

# Credenciais para imprimir em filas compartilhadas do Windows (\\host\fila).
# Deixe em branco se você só imprime por IP direto (porta 9100).
SMB_USER=
SMB_PASSWORD=
SMB_DOMAIN=
